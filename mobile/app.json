{
  "expo": {
    "name": "Canopy",
    "slug": "canopy-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f4f4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canopy.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Canopy uses your microphone for the room call, private calls and voice notes.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.canopy.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Canopy uses your microphone for the room call, private calls and voice notes."
        }
      ]
    ]
  }
}
